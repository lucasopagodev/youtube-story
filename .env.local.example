# YouTube Data API v3 (opcional)
# Sem ela, o app usa noembed.com como fallback (sem avatar do canal)
# Crie sua key gratuita em: https://console.cloud.google.com
# Ative a "YouTube Data API v3" e crie uma credencial do tipo "API key"
YOUTUBE_API_KEY=

# Rate limit compartilhado para produção (opcional)
# Sem ele, o app aplica um limite local por instância da aplicação.
# Crie em https://upstash.com/ e copie as credenciais REST do Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
